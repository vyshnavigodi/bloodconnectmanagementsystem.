# ============================================
# BloodConnect Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Backend Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/bloodconnect

# --- JWT Authentication ---
JWT_SECRET=bloodconnect_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# --- Bcrypt ---
BCRYPT_ROUNDS=12

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Email (Optional - configurable) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@bloodconnect.org

# --- AI Service (Optional) ---
AI_SERVICE_URL=http://localhost:8000

# --- File Uploads ---
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=10

# ============================================
# Frontend Variables (prefix with VITE_)
# ============================================
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=BloodConnect
